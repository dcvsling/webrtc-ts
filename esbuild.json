{
    "bundle": true,
    "charset": "utf8", 
    "tsconfig": "tsconfig.json",
    "platform": "browser",
    "entryPoints": [
        "src\\index.ts"
    ],
    "outdir": "dist",
    "mainFields": ["module"],
    "target": ["es2020","chrome58","edge16","firefox57","node12","safari11"],
    "globalName": "app",
    "resolveExtensions": [".ts", ".js", ".json", ".html"],
    "minify": true,
    "treeShaking": true,
    "sourcemap": true,
    "loader": {
        ".ts": "ts",
        ".png": "dataurl",
        ".jpg": "dataurl",
        ".svg": "text",
        ".json": "json",
        ".html": "file"
    },
    "logLevel": "verbose"

}